{
  "name": "testbuddylabs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run --pool=threads",
    "server": "tsx server/index.ts",
    "dev:server": "tsx watch server/index.ts",
    "dev:all": "concurrently -k -n \"CLIENT,SERVER\" -c \"cyan,magenta\" \"npm run dev\" \"npm run server\""
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.5",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "jspdf": "^4.2.1",
    "lucide": "^1.48.0"
  }
}
