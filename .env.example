# Supabase Credentials (Get these from your project at https://supabase.com -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: Company / Helpline config
VITE_SUPPORT_PHONE=1800-8378-283
VITE_COMPANY_NAME=Diagnova_labs

# Notifications Configuration
# Admin WhatsApp number receiving live booking alerts (Default: 8217689128)
ADMIN_WHATSAPP_PHONE=918217689128
WHATSAPP_WEBHOOK_URL=

# SMTP Credentials for Automated Patient Confirmation Emails (Gmail, SendGrid, SES, Mailgun)
# If left unset, email delivery runs in safe simulation mode with full HTML log output
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Diagnova Labs <no-reply@diagnovalabs.com>"
